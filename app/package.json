{
  "name": "ncaa2mindrill-app",
  "version": "1.0.0",
  "private": true,
  "description": "NCAA Two-Minute Drill, wrapped as an iOS/Android app with Capacitor",
  "scripts": {
    "web": "node copy-web.js",
    "sync": "node copy-web.js && npx cap sync",
    "android": "node copy-web.js && npx cap sync android && npx cap open android",
    "ios": "node copy-web.js && npx cap sync ios && npx cap open ios",
    "assets": "npx @capacitor/assets generate --iconBackgroundColor '#0c1420' --iconBackgroundColorDark '#0c1420' --splashBackgroundColor '#0c1420' --splashBackgroundColorDark '#0c1420'"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/browser": "^6.0.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1",
    "@revenuecat/purchases-capacitor": "^9.1.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2"
  }
}
